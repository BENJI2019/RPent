# Copy to cluster.env INSIDE this algorithm package before platform submission.
# These absolute launcher prefixes match `conda create -n` environments created
# with CONDA_ENVS_PATH="$MINICONDA_PATH/envs". Verify with `echo "$CONDA_PREFIX"`.
export RETENTION_SIM_PREFIX=/home/ma-user/work/dataset/Common_wl/miniconda3/envs/hyy_vla-rc-sim
export RETENTION_OPENPI_PREFIX=/home/ma-user/work/dataset/Common_wl/miniconda3/envs/hyy_vla-rc-openpi
export RETENTION_QWEN_PREFIX=/home/ma-user/work/dataset/Common_wl/miniconda3/envs/hyy_vla-rc-qwen
export RETENTION_TOOLS_PREFIX=/home/ma-user/work/dataset/Common_wl/miniconda3/envs/hyy_vla-retention-tools

# Keep logical shared-volume paths on both local and MTP.
export RETENTION_HOME="${RETENTION_HOME:-/home/ma-user/work/model/xiaoyi_tmpstorage/hyy_files/rpent}"
export RETENTION_DATASETS="${RETENTION_DATASETS:-/home/ma-user/work/dataset/hyy_vla/robocasa365/datasets}"
export ROBOCASA_ASSETS_PATH="${ROBOCASA_ASSETS_PATH:-/home/ma-user/work/dataset/hyy_vla/robocasa365/assets}"
export RETENTION_CHECKPOINT="${RETENTION_CHECKPOINT:-$RETENTION_HOME/checkpoints/robocasa365/pi05_pretrain_human300/multitask_learning/75000}"
